# Copy to .env.local for local development. Never commit real values.
# Supabase project URL (Project Settings → Data API).
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase secret key (Project Settings → API Keys → Secret keys). Server-only:
# it is never sent to the browser and must not be prefixed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
